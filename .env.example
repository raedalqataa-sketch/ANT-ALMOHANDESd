# Optional requirements interpretation provider.
# Default is ollama to preserve existing deployments. Choose "gemini" explicitly.
AI_PROVIDER=ollama

# Set only on the server / hosting environment; never expose this value to a browser.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Existing optional Ollama configuration (used when AI_PROVIDER=ollama).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
