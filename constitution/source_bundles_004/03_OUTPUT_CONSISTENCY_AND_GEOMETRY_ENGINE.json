    "05_ELEVATION_RULES.json": {
      "system": {
        "name": "ANT_ALMOHANDES",
        "module": "ELEVATION_RULES",
        "version": "1.0.0",
        "core_principle": "SINGLE_SOURCE_OF_TRUTH",
        "source_of_geometry": "VALIDATED_GEOMETRY"
      },
      "required_views": [
        "NORTH",
        "SOUTH",
        "EAST",
        "WEST"
      ],
      "locked_elements": [
        "building_footprint",
        "floor_count",
        "floor_heights",
        "roof_levels",
        "wall_positions",
        "structural_axes",
        "columns",
        "stairs",
        "major_openings",
        "doors",
        "windows",
        "balconies",
        "projections",
        "setbacks",
        "entrance_positions",
        "garage_openings"
      ],
      "rules": [
        {
          "id": "ELV-FLR-001",
          "rule": "عدد الأدوار في كل واجهة يجب أن يطابق VALIDATED_GEOMETRY",
          "severity": "CRITICAL"
        },
        {
          "id": "ELV-OPEN-001",
          "rule": "كل باب ونافذة ظاهر في الواجهة يجب أن يكون له مصدر في المسقط والهندسة",
          "severity": "CRITICAL"
        },
        {
          "id": "ELV-BAL-001",
          "rule": "لا تنشأ بلكونة إلا إذا كانت موجودة في VALIDATED_GEOMETRY",
          "severity": "CRITICAL"
        },
        {
          "id": "ELV-VERT-001",
          "rule": "العناصر الرأسية المهمة يجب أن تتطابق عبر الأدوار",
          "severity": "CRITICAL"
        },
        {
          "id": "ELV-STYLE-001",
          "rule": "يمكن تغيير الخامات والألوان والإضاءة، ولا يجوز تغيير الهندسة",
          "severity": "HIGH"
        }
      ],
      "traceability": [
        "elevation_element_id",
        "source_geometry_id",
        "source_plan_id",
        "floor",
        "wall_id",
        "space_id"
      ],
      "multi_floor": {
        "principle": "BUILDING_FIRST_THEN_ELEVATIONS",
        "forbidden": [
          "GENERATE_EACH_ELEVATION_INDEPENDENTLY",
          "GENERATE_FACADE_FROM_TEXT_ONLY"
        ]
      },
      "validation": [
        "COMPARE_ALL_ELEVATIONS_WITH_GEOMETRY",
        "CHECK_FLOOR_COUNT",
        "CHECK_DOORS",
        "CHECK_WINDOWS",
        "CHECK_BALCONIES",
        "CHECK_ENTRANCES",
        "CHECK_ROOF",
        "CHECK_STRUCTURAL_ALIGNMENT"
      ],
      "final_rule": "الواجهة إسقاط هندسي للمبنى المعتمد وليست تصميمًا مستقلًا."
    },
